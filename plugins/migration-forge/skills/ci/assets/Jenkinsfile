// Generated by /migration-forge:ci. Runs the same deterministic gate as the local session.
// Needs Docker + Python 3.9+ on the agent: Semgrep, Gitleaks, Trivy and SonarQube run as containers.
// Placeholders {{...}} are filled by the ci skill.
pipeline {
  agent any
  options { timeout(time: 90, unit: 'MINUTES') }
  parameters {
    booleanParam(name: 'MODERNIZE_LOOP', defaultValue: false,
                 description: 'Let headless Claude remediate until the gate passes (needs ANTHROPIC_API_KEY and checks.cost.max_usd)')
  }
  environment {
    FORGE_GATES_OVERRIDE = '.forge-ci/gates.ci.json'
    F = 'python3 .forge-ci/scripts'
  }
  stages {
    stage('Legacy (frozen)') {
      steps {
        dir('legacy/{{NAME}}') { git url: '{{LEGACY_REPOSITORY_URL}}', branch: '{{LEGACY_REF}}' }
      }
    }
    stage('Install') {
      steps { dir('{{MODERNIZED_ROOT}}') { sh '''
{{INSTALL_COMMANDS}}
''' } }
    }
    stage('Env up') { steps { sh '$F/env.py up' } }
    stage('Baseline (once)') {
      when { expression { !fileExists('forge/gates/baseline/scorecard.json') } }
      steps { sh '$F/run_gates.py --baseline' }   // legacy static/security/pii; never fails
    }
    stage('Modernize loop') {
      when { expression { params.MODERNIZE_LOOP } }
      environment { ANTHROPIC_API_KEY = credentials('anthropic-api-key') }
      steps {
        sh '''
          set -o pipefail
          for i in $(seq 1 10); do
            $F/cost_estimate.py check || { echo "budget exhausted or a call's cost is unknown"; break; }   # exit 42 = stop
            CAP=$($F/cost_estimate.py remaining)
            claude -p "/migration-forge:remediate. Fix every item in the latest forge/gates/iteration-*/feedback.md." \
                   --output-format json --max-budget-usd "$CAP" --permission-mode acceptEdits \
              | $F/cost_estimate.py record-claude --label "remediate-$i" || true
            $F/env.py up && $F/evals_run.py || true
            $F/run_gates.py && break
          done
        '''
      }
    }
    stage('Evals') { steps { sh '$F/evals_run.py' } }
    stage('Gate') {
      steps {
        sh '$F/run_gates.py'
        sh 'test -f forge/gates/baseline/scorecard.json && $F/gate_compare.py || true'
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'forge/gates/**, forge/evals/results*.json, forge/cost/**', allowEmptyArchive: true
      sh '$F/env.py down || true'
      sh '$F/sonar.py down || true'
    }
  }
}
